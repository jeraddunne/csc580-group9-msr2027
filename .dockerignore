# Keep the build context to what a fresh clone contains.
.git
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.coverage
htmlcov
*.egg-info
build
site
data/samples/*
!data/samples/.gitkeep
data/annotations/work
